{
  "name": "agent-workbench-desktop",
  "version": "0.1.2",
  "license": "MIT",
  "author": "Agent Workbench contributors",
  "description": "Independent local desktop workbench for AI coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASER-ho/agent-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/ASER-ho/agent-workbench/issues"
  },
  "homepage": "https://github.com/ASER-ho/agent-workbench",
  "main": "./out/main/index.js",
  "scripts": {
    "test": "node scripts/run-all-tests.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/verify-node-pty-prebuild.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "smoke": "playwright test smoke.spec.ts",
    "test:paths": "node --experimental-strip-types --no-warnings --test tests/unit/fixture-paths.test.mts",
    "test:fs": "node --experimental-strip-types --no-warnings --test tests/unit/fs-ipc-boundary.test.mts",
    "test:session": "node --experimental-strip-types --no-warnings --test tests/unit/stub-session.test.mts",
    "test:action": "node --experimental-strip-types --no-warnings --test tests/unit/controlled-action.test.mts",
    "test:rollback": "node --experimental-strip-types --no-warnings --test tests/unit/model-rollback-boundary.test.mts",
    "test:result-workbench": "node --experimental-strip-types --no-warnings --test tests/unit/result-workbench.test.mts",
    "test:readiness": "node --experimental-strip-types --no-warnings --test tests/unit/readiness-rules.test.mts",
    "test:electron": "playwright test -c playwright.electron.config.ts",
    "test:static": "node --experimental-strip-types --no-warnings --test tests/static/stage-a-safety.test.mts tests/static/stage-d-release.test.mts tests/static/private-path-scan.test.mts tests/static/brand-scan.test.mts tests/static/browser-smoke-harness.test.mts tests/static/credential-shape-scan.test.mts",
    "test:privacy": "node scripts/private-path-scan.mjs src out",
    "test:brand": "node --experimental-strip-types --no-warnings --test tests/static/brand-scan.test.mts",
    "dev:renderer": "electron-vite dev --rendererOnly",
    "test:smoke-harness": "node --experimental-strip-types --no-warnings --test tests/static/browser-smoke-harness.test.mts",
    "test:credentials": "node --experimental-strip-types --no-warnings --test tests/static/credential-shape-scan.test.mts",
    "test:navigation": "node --experimental-strip-types --no-warnings --test tests/unit/navigation-security.test.mts",
    "test:ipc-sender": "node --experimental-strip-types --no-warnings --test tests/unit/trusted-ipc.test.mts",
    "test:api-boundary": "node --experimental-strip-types --no-warnings --test tests/unit/api-url-boundary.test.mts",
    "test:verification": "node --experimental-strip-types --no-warnings --test tests/unit/verification-contract.test.mts tests/unit/git-verification.test.mts tests/unit/inspection-guard.test.mts tests/unit/workspace-foundation.test.mts",
    "test:criterion": "node --experimental-strip-types --no-warnings --test tests/unit/criterion-evaluator.test.mts tests/unit/evidence-binding.test.mts",
    "test:secret-store": "node --experimental-strip-types --no-warnings --test tests/unit/secret-store.test.mts",
    "test:controlled-verification": "node --experimental-strip-types --no-warnings --test tests/unit/controlled-verification-manager.test.mts",
    "test:r2b2b-r2c": "node --experimental-strip-types --no-warnings --test tests/unit/evidence-freshness.test.mts tests/unit/verification-subject-snapshot.test.mts tests/unit/node-recipe.test.mts tests/unit/controlled-verification-manager.test.mts",
    "test:r2d": "node --experimental-strip-types --no-warnings --test tests/unit/overall-verdict.test.mts tests/unit/verification-receipt.test.mts tests/unit/handoff-markdown.test.mts tests/unit/verification-export-service.test.mts",
    "test:observation": "node --experimental-strip-types --no-warnings --test tests/unit/observation-events.test.mts tests/unit/transcript-watcher.test.mts tests/unit/hook-installer.test.mts tests/unit/auto-verifier.test.mts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "node-pty": "1.2.0-beta.12"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.agentworkbench.desktop",
    "productName": "Agent Workbench",
    "npmRebuild": false,
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!**/*.map",
      "!node_modules/node-pty/prebuilds/darwin-arm64/**",
      "!node_modules/node-pty/prebuilds/darwin-x64/**",
      "!node_modules/node-pty/prebuilds/linux-arm64/**",
      "!node_modules/node-pty/prebuilds/linux-x64/**",
      "!node_modules/node-pty/prebuilds/win32-arm64/**",
      "!node_modules/node-pty/third_party/conpty/1.25.260303002/win10-arm64/**"
    ],
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "executableName": "Agent Workbench"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Agent Workbench",
      "uninstallDisplayName": "Agent Workbench ${version}"
    },
    "artifactName": "Agent Workbench Setup ${version}.${ext}"
  }
}
